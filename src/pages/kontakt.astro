---
/**
 * Kontakt - Termin vereinbaren
 * @author andreas@siglochconsulting.de
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Calendly from '../components/Calendly.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '@lib/config';
---

<BaseLayout
  title="Kontakt - Gespräch vereinbaren | Sigloch Consulting"
  description="30 Minuten klären, ob der Ansatz zu Ihrer Situation passt. Termin online buchen oder Nachricht senden."
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" data-testid="kontakt-hero">
      <div class="container">
        <h1>Kontakt</h1>
        <p class="hero-subtitle">
          30 Minuten klären, ob der Ansatz passt
        </p>
      </div>
    </section>

    <!-- Contact Options -->
    <section class="contact-section" data-testid="contact-section">
      <div class="container">
        <div class="contact-grid">
          <!-- Calendly -->
          <div class="contact-option calendly-option">
            <h2>Termin vereinbaren</h2>
            <p>
              Am einfachsten: Buchen Sie direkt einen passenden Termin in meinem Kalender.
              Kein Sales-Pitch – ein fachliches Gespräch über Ihre Situation.
            </p>
            <Calendly />
          </div>

          <!-- Contact Form -->
          <div class="contact-option form-option">
            <ContactForm showHeader={false} formId="kontakt-form" />
          </div>
        </div>

        <!-- Direct Contact -->
        <div class="direct-contact">
          <h2>Direkt erreichen</h2>
          <div class="contact-methods">
            <a href={`tel:${siteConfig.contact.phone.replace(/\s/g, '')}`} class="contact-method">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{siteConfig.contact.phone}</span>
            </a>

            <a href={`mailto:${siteConfig.contact.email}`} class="contact-method">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>{siteConfig.contact.email}</span>
            </a>

            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="contact-method">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>

          <div class="address">
            <p>
              <strong>{siteConfig.contact.name}</strong><br/>
              {siteConfig.contact.company}<br/>
              {siteConfig.contact.address.street}<br/>
              {siteConfig.contact.address.zip} {siteConfig.contact.address.city}
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
  }

  .page-hero h1 {
    margin-bottom: var(--space-4);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  /* Contact Section */
  .contact-section {
    padding: var(--space-16) 0;
    background: var(--color-background);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .contact-option {
    background: var(--color-background-alt);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
  }

  .contact-option h2 {
    margin-bottom: var(--space-4);
  }

  .contact-option p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    line-height: var(--leading-relaxed);
  }

  /* Direct Contact */
  .direct-contact {
    text-align: center;
    padding: var(--space-12);
    background: var(--color-primary-50);
    border-radius: var(--radius-lg);
  }

  .direct-contact h2 {
    margin-bottom: var(--space-8);
  }

  .contact-methods {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--color-background);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-text);
    font-weight: var(--font-medium);
    transition: all var(--transition-base);
    box-shadow: var(--shadow-sm);
  }

  .contact-method:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: var(--color-primary);
  }

  .contact-method svg {
    color: var(--color-primary);
  }

  .address {
    color: var(--color-text-secondary);
  }

  .address p {
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-methods {
      flex-direction: column;
      align-items: center;
    }

    .contact-method {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }
  }
</style>
