---
/**
 * graphcode-Demo — ein aus dem Modell gedrucktes Dokument
 * @author andreas@siglochconsulting.de
 *
 * Inhalt: src/data/graphcode-demo/<slug>.md — 1:1 die Exporte aus dem Demo-Repo
 * (graphcodedemo/docs/views/). Generiert, nicht von Hand geschrieben, englisch.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { demoDocs, demoStats } from '@lib/graphcodeDemo';

const modules = import.meta.glob<{ compiledContent: () => string | Promise<string> }>(
  '../../../data/graphcode-demo/*.md',
  { eager: true }
);

const bySlug = Object.fromEntries(
  Object.entries(modules).map(([path, mod]) => [path.split('/').pop()!.replace(/\.md$/, ''), mod])
);

export function getStaticPaths() {
  return demoDocs.map((doc, index) => ({
    params: { doc: doc.slug },
    props: {
      doc,
      prev: index > 0 ? demoDocs[index - 1] : null,
      next: index < demoDocs.length - 1 ? demoDocs[index + 1] : null,
    },
  }));
}

const { doc, prev, next } = Astro.props;

const compiled = await bySlug[doc.slug].compiledContent();
// Generator-Kommentar und die erste Überschrift entfallen — der Seitenkopf trägt den
// deutschen Titel.
const html = compiled
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '');
---

<BaseLayout
  title={`${doc.title} - graphcode-Demo | Sigloch Consulting`}
  description={`${doc.summary} Aus dem Modell des City People Mover generiert, nicht von Hand geschrieben.`}
>
  <Header />

  <main>
    <article class="article" data-testid={`gc-doc-${doc.slug}`}>
      <header class="article-header">
        <div class="container">
          <a href="/projekte/graphcode-demo" class="back-link">← graphcode-Demo</a>
          <h1>{doc.title}</h1>
          <p class="article-subtitle">{doc.summary}</p>
          <p class="generated-note">
            Aus dem Modell generiert — Snapshot vom {demoStats.snapshotDate},
            graphcode {demoStats.graphcodeVersion}. Modellsprache ist Englisch.
          </p>
        </div>
      </header>

      <div class="container doc-content" set:html={html} />

      <nav class="doc-nav container" aria-label="Dokumentnavigation">
        {prev ? (
          <a href={`/projekte/graphcode-demo/${prev.slug}`} class="nav-link" data-testid="doc-prev">
            ← {prev.title}
          </a>
        ) : <span />}
        {next && (
          <a href={`/projekte/graphcode-demo/${next.slug}`} class="nav-link nav-next" data-testid="doc-next">
            {next.title} →
          </a>
        )}
      </nav>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-header {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-16) 0 var(--space-10) 0;
  }

  .back-link {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .article-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 70ch;
  }

  .generated-note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .doc-content {
    max-width: 900px;
    padding: var(--space-12) var(--container-padding);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .doc-content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .doc-content :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .doc-content :global(h4) {
    font-size: var(--text-lg);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .doc-content :global(p) {
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
  }

  .doc-content :global(ul),
  .doc-content :global(ol) {
    margin: 0 0 var(--space-4) var(--space-6);
    color: var(--color-text-secondary);
  }

  .doc-content :global(blockquote) {
    margin: 0 0 var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    background: var(--color-background-alt);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .doc-content :global(blockquote p) {
    margin-bottom: 0;
  }

  .doc-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
  }

  .doc-content :global(th),
  .doc-content :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
  }

  .doc-content :global(th) {
    background: var(--color-background-alt);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .doc-content :global(code) {
    background: var(--color-background-muted);
    padding: 0 var(--space-1);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .doc-content :global(pre) {
    background: var(--color-background-alt);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }

  .doc-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .doc-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 900px;
    padding: 0 var(--container-padding) var(--space-16) var(--container-padding);
  }

  .nav-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  .nav-next {
    text-align: right;
  }

  @media (max-width: 768px) {
    .article-header h1 {
      font-size: var(--text-3xl);
    }

    .doc-nav {
      flex-direction: column;
    }

    .nav-next {
      text-align: left;
    }
  }
</style>
