---
/**
 * Projekte - Was ich gebaut habe
 * @author andreas@siglochconsulting.de
 *
 * Kategorien: PropTech, Systems Engineering, Sonstiges
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

interface Project {
  name: string;
  status: "Aktiv" | "Archiv" | "Abgeschlossen";
  language: string;
  description: string;
  goal?: string;
  features?: string[];
  links?: { label: string; url: string }[];
}

interface Category {
  title: string;
  id: string;
  projects: Project[];
}

const categories: Category[] = [
  {
    title: "PropTech",
    id: "proptech",
    projects: [
      {
        name: "sigloch-immobilien",
        status: "Aktiv",
        language: "Astro",
        description: "Immobilien-Website für Sigloch Immobilien.",
        goal: "Mit Coding Agent wartbare Website, minimierte Abhängigkeiten, optimale SEO/GEO Performance.",
        features: [
          "Astro 5.x, PropStack CRM Integration",
          "IONOS SFTP Deployment",
          "Keine externen JS-Frameworks",
          "DSGVO/BFSG Compliance als Git-Hooks"
        ],
        links: [
          { label: "Website", url: "https://sigloch-immobilien.de" }
        ]
      },
      {
        name: "propstack-mcp",
        status: "Aktiv",
        language: "TypeScript",
        description: "MCP Server für PropStack Immobilien-API.",
        goal: "CRM-Daten verfügbar machen für Workflows & Agents.",
        features: [
          "Read-only, DSGVO-konform",
          "GPS-Koordinaten gerundet, Makler-Daten gefiltert",
          "npm-Paket oder .mcpb-Bundle"
        ],
        links: [
          { label: "GitHub", url: "https://github.com/andreassigloch/propstack-mcp" }
        ]
      },
      {
        name: "imphoto",
        status: "Aktiv",
        language: "JavaScript",
        goal: "Effizienzsteigerung und MVP für App-Deployment",
        description: "Electron-App zur Automatisierung des Immobilien-Foto-Workflows.",
        features: [
          "6 Phasen von Import bis Export",
          "Automatische Benennung ({ObjektNr}-{Raum}-{Nr})",
          "Drag&Drop Sortierung"
        ]
      }
    ]
  },
  {
    title: "Systems Engineering & Graphs",
    id: "systems-engineering",
    projects: [
      {
        name: "graphcode-Demo: City People Mover",
        status: "Aktiv",
        language: "TypeScript",
        description: "Vollständig modelliertes Beispielsystem — Spezifikation als zusammenhängendes Modell statt Dokumentenordner.",
        goal: "graphcode zeigen, ohne vorher etwas bauen zu müssen: 219 Einträge, 402 Verknüpfungen, 15 daraus generierte Dokumente.",
        features: [
          "Fahrerloser City People Mover, acht Stationen, eine Leitstelle",
          "Jede Änderung läuft durch dieselbe Prüfung — Mensch wie KI-Agent",
          "Statusbericht aus dem Modell berechnet, nicht in eine Folie getippt"
        ],
        links: [
          { label: "Statische Demo", url: "/projekte/graphcode-demo" },
          { label: "npm", url: "https://www.npmjs.com/package/@sigloch/graphcode" }
        ]
      },
      {
        name: "GraphEngine",
        status: "Aktiv",
        language: "TypeScript",
        description: "Weiterentwicklung von AiSE.",
        goal: "Optimierte LLM-Engine mit Streaming, schnellen Responses und erweiterten Rules für Self-Learning.",
        features: [
          "AgentDB als zentrale In-Memory-Datenbank",
          "Optimiertes Datenhandling (Prompt Compression, Diff)",
          "Reines Terminal UI"
        ],
        links: [
          { label: "GitHub", url: "https://github.com/andreassigloch/flowtwo" }
        ]
      },
      {
        name: "AiSe",
        status: "Archiv",
        language: "JavaScript/Python",
        description: "Graph-basierte SE-Plattform mit LLM-Assistent.",
        goal: "Nutzung von LLM zum Erstellen von SE-Modellen auf Basis einer Ontologie.",
        features: [
          "Neo4j Backend",
          "UI zur Anzeige und Manipulation von Graphen"
        ],
        links: [
          { label: "Demo", url: "https://aise.waffelwurst.de" }
        ]
      },
      {
        name: "sysli",
        status: "Archiv",
        language: "-",
        description: "Prototyp für KI-gestütztes Systems Engineering.",
        goal: "Beispieldaten, Prompts und Scripts zu LinkedIn-Posts. Grundlage für AiSe/GraphEngine Ontologie.",
        links: [
          { label: "GitHub", url: "https://github.com/andreassigloch/sysli" }
        ]
      },
      {
        name: "PromptCompression",
        status: "Abgeschlossen",
        language: "Python",
        description: "Forschungsprojekt zur Token-Optimierung von Graph-Daten für LLMs.",
        goal: "69% Token-Reduktion bei 100% LLM-Erfolgsrate.",
        features: [
          "Entwickelt 'Format E' als kompaktes Austauschformat"
        ],
        links: [
          { label: "GitHub", url: "https://github.com/andreassigloch/PromptCompression" }
        ]
      }
    ]
  },
  {
    title: "Sonstiges",
    id: "sonstiges",
    projects: [
      {
        name: "Projektprozess",
        status: "Aktiv",
        language: "Methodik",
        description: "6 Schritte zur strukturierten Datenreife.",
        goal: "Vom Status-Check bis zur KI-Aktivierung – strukturiert zum Business Value.",
        features: [
          "Status-Check: Wo stehen Sie auf der Datenreife-Leiter?",
          "Struktur vor KI: 70-80% des Werts aus Regeln",
          "Reproduzierbare, auditierbare Ergebnisse"
        ],
        links: [
          { label: "Details", url: "/projekte/projektablauf" }
        ]
      },
      {
        name: "PitchTrainer",
        status: "Aktiv",
        language: "JavaScript/HTML",
        description: "Pitch-Trainer mit Echtzeit-Feedback.",
        goal: "Feasibility-Studie für Spracherkennung + KI-Bewertung.",
        features: [
          "Deutsche Spracherkennung (Web Speech API + Voxtral)",
          "KI-Bewertung (Mistral)",
          "45s/60s Formate, mobil-optimiert"
        ],
        links: [
          { label: "Demo", url: "https://pitrain.waffelwurst.de" },
          { label: "GitHub", url: "https://github.com/andreassigloch/pitrain" }
        ]
      }
    ]
  }
];

const statusColors: Record<string, string> = {
  "Aktiv": "status-active",
  "Archiv": "status-archive",
  "Abgeschlossen": "status-completed"
};
---

<BaseLayout
  title="Projekte - Was ich gebaut habe | Sigloch Consulting"
  description="PropTech, Systems Engineering Tools und Open Source Projekte. Code, Demos und GitHub-Repositories."
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" data-testid="projects-hero">
      <div class="container">
        <h1>Projekte</h1>
        <p class="hero-subtitle">
          Was ich gebaut habe – von PropTech bis Systems Engineering
        </p>
        <p class="hero-github">
          <a href="https://github.com/andreassigloch" target="_blank" rel="noopener noreferrer">
            GitHub: andreassigloch
          </a>
        </p>
      </div>
    </section>

    <!-- Category Navigation -->
    <nav class="category-nav" data-testid="category-nav">
      <div class="container">
        {categories.map((cat) => (
          <a href={`#${cat.id}`} class="category-link">{cat.title}</a>
        ))}
      </div>
    </nav>

    <!-- Project Categories -->
    {categories.map((category) => (
      <section class="projects-section" id={category.id} data-testid={`section-${category.id}`}>
        <div class="container">
          <h2 class="section-title">{category.title}</h2>

          <div class="projects-grid">
            {category.projects.map((project, index) => (
              <article class="project-card" data-testid={`project-${category.id}-${index}`}>
                <div class="project-header">
                  <span class="project-language">{project.language}</span>
                  <span class:list={["project-status", statusColors[project.status]]}>
                    {project.status}
                  </span>
                </div>

                <h3 class="project-name">{project.name}</h3>
                <p class="project-description">{project.description}</p>

                {project.goal && (
                  <p class="project-goal">
                    <strong>Ziel:</strong> {project.goal}
                  </p>
                )}

                {project.features && project.features.length > 0 && (
                  <ul class="project-features">
                    {project.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                )}

                {project.links && project.links.length > 0 && (
                  <div class="project-links">
                    {project.links.map((link) => {
                      const isExternal = link.url.startsWith('http');
                      return (
                        <a
                          href={link.url}
                          target={isExternal ? '_blank' : undefined}
                          rel={isExternal ? 'noopener noreferrer' : undefined}
                          class="project-link"
                        >
                          {link.label} →
                        </a>
                      );
                    })}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- CTA Section -->
    <section class="cta-section" data-testid="projects-cta">
      <div class="container cta-content">
        <h2>Interesse an Zusammenarbeit?</h2>
        <p>
          Lassen Sie uns besprechen, wie diese Technologien für Ihr Projekt eingesetzt werden können.
        </p>
        <a href="/kontakt" class="button button-primary button-large" data-testid="cta-contact">
          Gespräch vereinbaren
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-20) 0 var(--space-12);
    text-align: center;
  }

  .page-hero h1 {
    margin-bottom: var(--space-4);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .hero-github a {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .hero-github a:hover {
    text-decoration: underline;
  }

  /* Category Navigation */
  .category-nav {
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .category-nav .container {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
  }

  .category-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: var(--font-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .category-link:hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  /* Projects Section */
  .projects-section {
    padding: var(--space-16) 0;
  }

  .projects-section:nth-child(odd) {
    background: var(--color-background-alt);
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-4);
    border-bottom: 3px solid var(--color-primary);
    display: inline-block;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-8);
  }

  /* Project Card */
  .project-card {
    background: var(--color-background);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--color-primary);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .projects-section:nth-child(odd) .project-card {
    background: var(--color-background);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .project-language {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    font-weight: var(--font-medium);
  }

  .project-status {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .status-active {
    background: var(--color-success-bg);
    color: var(--color-success-text);
  }

  .status-archive {
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
  }

  .status-completed {
    background: var(--color-info-bg);
    color: var(--color-info-text);
  }

  .project-name {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .project-description {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .project-goal {
    color: var(--color-text);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    padding: var(--space-3);
    background: var(--color-primary-50);
    border-radius: var(--radius-md);
  }

  .project-goal strong {
    color: var(--color-primary);
  }

  .project-features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    flex-grow: 1;
  }

  .project-features li {
    padding: var(--space-2) 0;
    padding-left: var(--space-6);
    position: relative;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .project-features li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .project-links {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .project-link {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .project-link:hover {
    color: var(--color-primary-600);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-16) 0;
    background: linear-gradient(
      135deg,
      var(--color-primary-700) 0%,
      var(--color-primary-600) 50%,
      var(--color-primary-700) 100%
    );
    color: var(--color-background);
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-section h2 {
    color: var(--color-background);
    margin-bottom: var(--space-4);
  }

  .cta-section p {
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
    opacity: 0.9;
  }

  .cta-section .button-primary {
    background: var(--color-background);
    color: var(--color-primary);
    border-color: var(--color-background);
  }

  .cta-section .button-primary:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .category-nav .container {
      gap: var(--space-3);
    }

    .category-link {
      font-size: var(--text-sm);
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
