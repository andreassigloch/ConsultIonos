---
/**
 * Hintergrund: 7 Fragen
 * @author andreas@siglochconsulting.de
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
---

<BaseLayout
  title="7 Fragen zur Datenstrukturierung | Sigloch Consulting"
  description="Warum jetzt? Was kostet es? Wie fange ich an? Die wichtigsten Fragen zur Datenstrukturierung – ehrlich beantwortet."
>
  <Header />

  <main>
    <article class="article" data-testid="article-7-fragen">
      <header class="article-header">
        <div class="container">
          <a href="/hintergrund" class="back-link">← Hintergrund</a>
          <h1>7 Fragen</h1>
          <p class="article-subtitle">
            Die wichtigsten Fragen zur Datenstrukturierung – ehrlich beantwortet
          </p>
        </div>
      </header>

      <div class="container article-content">
        <section class="faq-full">
          <FAQ />
        </section>

        <section>
          <h2>Investitions-Richtwerte</h2>
          <p>
            Transparente Orientierung statt unverbindlicher "kommt drauf an"-Aussagen:
          </p>

          <div class="cost-table-wrapper">
            <table class="cost-table">
              <thead>
                <tr>
                  <th>Stufenwechsel</th>
                  <th>Investition</th>
                  <th>Zeitraum</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Stufe 2 → 3 (Vernetzte Daten)</td>
                  <td>€10.000 - 30.000</td>
                  <td>2-4 Monate</td>
                </tr>
                <tr>
                  <td>Stufe 3 → 4 (Automatische Prüfung)</td>
                  <td>€15.000 - 40.000</td>
                  <td>3-6 Monate</td>
                </tr>
                <tr>
                  <td>Stufe 4 → 5 (Messbare Qualität)</td>
                  <td>€20.000 - 50.000</td>
                  <td>4-8 Monate</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="note">
            <strong>Kein SaaS-Modell:</strong> Nach der Implementierung fallen keine
            laufenden API-Kosten an. Das System gehört Ihnen.
          </p>
        </section>

        <section class="cta-box">
          <h2>Bereit für den ersten Schritt?</h2>
          <p>
            30 Minuten Gespräch klären, ob der Ansatz zu Ihrer Situation passt.
          </p>
          <a href="/kontakt" class="button button-primary">Gespräch vereinbaren</a>
        </section>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-header {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-16) 0;
  }

  .back-link {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-header h1 {
    margin-bottom: var(--space-4);
  }

  .article-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  .article-content {
    max-width: 850px;
    padding: var(--space-12) var(--container-padding);
  }

  .article-content section {
    margin-bottom: var(--space-12);
  }

  .faq-full {
    margin-bottom: var(--space-16);
  }

  .article-content h2 {
    margin-bottom: var(--space-6);
    margin-top: var(--space-8);
  }

  .article-content p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .cost-table-wrapper {
    overflow-x: auto;
    margin: var(--space-8) 0;
  }

  .cost-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-background);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .cost-table th {
    background: var(--color-primary);
    color: var(--color-background);
    padding: var(--space-4) var(--space-5);
    text-align: left;
    font-weight: var(--font-semibold);
  }

  .cost-table td {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .cost-table tr:last-child td {
    border-bottom: none;
  }

  .note {
    background: var(--color-primary-50);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-primary);
  }

  .cta-box {
    background: var(--color-primary-50);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    text-align: center;
    margin-top: var(--space-16);
  }

  .cta-box h2 {
    margin-top: 0;
  }

  .cta-box p {
    margin-bottom: var(--space-6);
  }
</style>
