---
/**
 * Homepage v2.0 - Sigloch Consulting
 * @author andreas@siglochconsulting.de
 *
 * "Daten strukturieren. Qualität messbar machen."
 * Systematischer Ansatz für Unternehmen, die ihre Prozesse auf eine
 * belastbare Grundlage stellen wollen – bevor sie über KI nachdenken.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import { siteConfig } from '@lib/config';
---

<BaseLayout
  title="Sigloch Consulting - Struktur vor KI. Mehrwert durch KI."
  description="Die meisten KI-Projekte scheitern – weil die Voraussetzungen fehlen. Systematischer Ansatz für Unternehmen, die echten KI-Mehrwert wollen."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero" data-testid="hero-section">
      <div class="container hero-content">
        <div class="hero-text">
          <h1>Struktur vor KI.<br/>Mehrwert durch KI.</h1>
          <p class="hero-subtitle">
            Ein systematischer Ansatz für Unternehmen, die ihre Prozesse auf eine
            belastbare Grundlage stellen wollen – Denn das ist die Basis für sinnvolle und effiziente KI Anwendung. Branchenunabhängig.
          </p>

          <div class="hero-cta">
            <a href="/kontakt" class="button button-primary button-large" data-testid="cta-contact">
              Gespräch vereinbaren
            </a>
            <a href="/mein-ansatz" class="button button-secondary button-large" data-testid="cta-approach">
              Mein Ansatz
            </a>
          </div>
        </div>

        <div class="hero-image">
          <img
            src="/images/andreas-sigloch.png"
            alt="Andreas Sigloch - Consulting für Datenstruktur und Qualitätsmessung"
            class="portrait-image"
            width="400"
            height="400"
          />
        </div>
      </div>
    </section>

    <!-- Problem Section -->
    <section class="problem-section" data-testid="problem-section">
      <div class="container">
        <h2>Das Problem</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <div class="problem-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <h3>Informationen verstreut</h3>
            <p>Daten liegen in verschiedenen Systemen, Formaten und Ordnern – Ohne erkennbare Verbindung.</p>
          </div>

          <div class="problem-card">
            <div class="problem-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3>Wissen in Köpfen</h3>
            <p>Erfahrungswissen steckt bei einzelnen Mitarbeitern – Wenn sie gehen, geht das Wissen mit.</p>
          </div>

          <div class="problem-card">
            <div class="problem-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <circle cx="12" cy="17" r="1" stroke="none" fill="currentColor"></circle>
              </svg>
            </div>
            <h3>Entscheidungen nicht nachvollziehbar</h3>
            <p>Das müssten wir doch aus unseren Daten sehen können? Aber wer hat die Info? Wo? Wie? - Für Entscheidungen und Audits fehlen die Antworten.</p>
          </div>

          <div class="problem-card">
            <div class="problem-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <circle cx="12" cy="17" r="1" stroke="none" fill="currentColor"></circle>
              </svg>
            </div>
            <h3>Bedenken</h3>
            <p>EU AI Act, Jobverlust, Know-how-Defizite. Wichtige Fragen – aber beantwortbar.</p>
          </div>
        </div>

        <div class="problem-statement">
          <p><strong>KI-Tools alleine können das nur lindern.</strong> Nicht lösen.</p>
        </div>
      </div>
    </section>

    <!-- Solution Section -->
    <section class="solution-section" data-testid="solution-section">
      <div class="container">
        <h2>Der Ansatz: Struktur vor Technologie</h2>
        <p class="solution-intro">
          Ein Stufenmodell, das den Fokus auf das Wesentliche legt – Datenmanagement vor Technologie-Entscheidungen.
        </p>

        <div class="solution-steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Daten strukturieren</h3>
            <p>Informationen erfassen, verknüpfen und durchsuchbar machen.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Regeln automatisieren</h3>
            <p>Geschäftsregeln in prüfbare Abläufe übersetzen.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Qualität messen</h3>
            <p>Scores statt Bauchgefühl – objektive Bewertungskriterien.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-number">4</div>
            <h3>KI nur wo nötig</h3>
            <p>Gezielte KI-Unterstützung für Aufgaben, die Urteilsvermögen erfordern.</p>
          </div>
        </div>

        <div class="solution-result">
          <p><strong>Ergebnis:</strong> Systeme mit reproduzierbaren Ergebnissen, planbaren Kosten und voller Nachvollziehbarkeit.</p>
        </div>
      </div>
    </section>

    <!-- Application Section -->
    <section class="application-section" data-testid="application-section">
      <div class="container">
        <h2>Anwendungsbereiche</h2>
        <div class="application-grid">
          <div class="application-card">
            <h3>Systems Engineering</h3>
            <p>
              Graph-basierte Modellierung nach INCOSE-Methodik. Anforderungen, Architektur und Testfälle
              als vernetzte Daten – mit automatischer Impact-Analyse und Compliance-Prüfung.
            </p>
            <ul>
              <li>Requirements Traceability</li>
              <li>Change Impact Analysis</li>
              <li>Compliance-Checks (A-SPICE, ISO 26262, MDR)</li>
            </ul>
          </div>

          <div class="application-card">
            <h3>Immobilienbranche</h3>
            <p>
              Wie der Strukturansatz konkret aussieht – am eigenen Geschäftsfeld erprobt.
              PropStack-Daten als Kern, angereichert mit externen Quellen, automatisch auf alle Kanäle ausgespielt.
            </p>
            <ul>
              <li>CRM als Single Source of Truth für Website & Portale</li>
              <li>Lage-Scores aus POI-Daten statt subjektiver Beschreibungen</li>
              <li>Automatische Ausspielung auf Social Media</li>
            </ul>
          </div>

          <div class="application-card">
            <h3>Ihre Branche</h3>
            <p>
              Dieselbe Methodik funktioniert überall, wo Entscheidungen auf verteilten Daten basieren:
              Beschaffung, Qualitätssicherung, Projektsteuerung, Due Diligence.
            </p>
            <ul>
              <li>Datenquellen verbinden statt Copy-Paste</li>
              <li>Entscheidungskriterien explizit machen</li>
              <li>KI-Assistenten, die auf Ihren Daten antworten – nicht halluzinieren</li>
            </ul>
          </div>
        </div>

        <div class="application-insight">
          <p><strong>Der Clou:</strong> Die KI-Benefits sind Konsequenz der Strukturarbeit, nicht Ausgangspunkt. Das differenziert von "Wir machen jetzt auch KI".</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section" data-testid="faq-section">
      <div class="container">
        <h2>Häufige Fragen</h2>
        <FAQ />
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" data-testid="cta-section">
      <div class="container cta-content">
        <h2>Passt das für Sie?</h2>
        <p>
          30 Minuten reichen, um zu klären, ob der Ansatz zu Ihrer Situation passt.
          Kein Sales-Pitch, sondern ein fachliches Gespräch.
        </p>
        <a href="/kontakt" class="button button-primary button-large" data-testid="cta-final">
          Gespräch vereinbaren
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 50%,
      var(--color-primary-50) 100%
    );
    padding: var(--space-24) 0 var(--space-16) 0;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-text h1 {
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    line-height: var(--leading-relaxed);
  }

  .hero-cta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .portrait-image {
    width: 100%;
    max-width: 400px;
    height: auto;
    border-radius: 50%;
    box-shadow: var(--shadow-xl);
    object-fit: cover;
    aspect-ratio: 1;
  }

  /* Problem Section */
  .problem-section {
    padding: var(--space-16) 0;
    background: var(--color-background);
  }

  .problem-section h2 {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .problem-card {
    background: var(--color-background-alt);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .problem-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .problem-card h3 {
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .problem-card p {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .problem-statement {
    text-align: center;
    padding: var(--space-6);
    background: var(--color-primary-50);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .problem-statement p {
    font-size: var(--text-lg);
    margin: 0;
    color: var(--color-text);
  }

  /* Solution Section */
  .solution-section {
    padding: var(--space-16) 0;
    background: var(--color-background-alt);
  }

  .solution-section h2 {
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .solution-intro {
    text-align: center;
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-12);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .solution-steps {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }

  .step {
    background: var(--color-background);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    text-align: center;
    flex: 1;
    min-width: 200px;
    max-width: 250px;
  }

  .step-number {
    width: 48px;
    height: 48px;
    background: var(--color-primary);
    color: var(--color-background);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin: 0 auto var(--space-4);
  }

  .step h3 {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .step p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .step-arrow {
    color: var(--color-primary);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    align-self: center;
    padding-top: var(--space-8);
  }

  .solution-result {
    text-align: center;
    padding: var(--space-6);
    background: var(--color-primary);
    color: var(--color-background);
    border-radius: var(--radius-lg);
    max-width: 800px;
    margin: 0 auto;
  }

  .solution-result p {
    font-size: var(--text-lg);
    margin: 0;
  }

  /* Application Section */
  .application-section {
    padding: var(--space-16) 0;
    background: var(--color-background);
  }

  .application-section h2 {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-8);
  }

  .application-card {
    background: var(--color-background-alt);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--color-primary);
  }

  .application-card h3 {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .application-card p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .application-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .application-card li {
    padding: var(--space-2) 0;
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-text);
  }

  .application-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: var(--font-bold);
  }

  .application-insight {
    text-align: center;
    padding: var(--space-6);
    background: var(--color-primary-50);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
    margin-top: var(--space-8);
  }

  .application-insight p {
    font-size: var(--text-lg);
    margin: 0;
    color: var(--color-text);
  }

  /* FAQ Section */
  .faq-section {
    padding: var(--space-16) 0;
    background: var(--color-background-alt);
  }

  .faq-section h2 {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-16) 0;
    background: linear-gradient(
      135deg,
      var(--color-primary-700) 0%,
      var(--color-primary-600) 50%,
      var(--color-primary-700) 100%
    );
    color: var(--color-background);
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-section h2 {
    color: var(--color-background);
    margin-bottom: var(--space-4);
  }

  .cta-section p {
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
    opacity: 0.9;
  }

  .cta-section .button-primary {
    background: var(--color-background);
    color: var(--color-primary);
    border-color: var(--color-background);
  }

  .cta-section .button-primary:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-cta {
      justify-content: center;
    }

    .step-arrow {
      display: none;
    }

    .solution-steps {
      flex-direction: column;
      align-items: center;
    }

    .step {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-16) 0 var(--space-12) 0;
    }

    .hero-text h1 {
      font-size: var(--text-4xl);
    }

    .hero-subtitle {
      font-size: var(--text-lg);
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-cta .button {
      width: 100%;
    }

    .problem-grid,
    .application-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
