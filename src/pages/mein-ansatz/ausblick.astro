---
/**
 * Hintergrund: Ausblick (Level 6-13)
 * @author andreas@siglochconsulting.de
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleNavigation from '../../components/ArticleNavigation.astro';


const advancedLevels = [
  {
    level: 6,
    name: "Vorausschauende Analyse",
    yourBenefit: "Probleme lösen bevor sie entstehen",
    description: "Das System erkennt Muster und warnt frühzeitig",
    example: "3 Wochen vor einem Lieferengpass gewarnt werden – nicht erst wenn die Produktion steht"
  },
  {
    level: 7,
    name: "Lernen aus Feedback",
    yourBenefit: "Jeden Tag ein bisschen besser",
    description: "Das System verbessert sich durch Ihre tägliche Nutzung",
    example: "Mitarbeiter-Korrekturen fließen automatisch in bessere Vorschläge"
  },
  {
    level: 8,
    name: "Selbstoptimierung",
    yourBenefit: "Das System verbessert sich selbst",
    description: "Automatische Korrektur und Optimierung ohne manuellen Eingriff",
    example: "Fehler im Datenmodell werden erkannt und repariert – bevor jemand nachfragt"
  }
];

const collaborationLevels = [
  {
    level: 9,
    name: "Föderiertes Lernen",
    yourBenefit: "Gemeinsam lernen, Daten behalten",
    description: "Mehrere Standorte oder Partner lernen gemeinsam – ohne Daten zu teilen",
    example: "Drei Werke optimieren gemeinsam ihre Qualitätsprozesse. Jeder profitiert, keiner sieht die Produktionsdaten der anderen."
  },
  {
    level: 10,
    name: "Ontologie-Konsens",
    yourBenefit: "Gemeinsame Sprache, dezentrale Kontrolle",
    description: "Branchenweite Standards entstehen durch Abstimmung – nicht durch Diktat",
    example: "Zulieferer und OEM einigen sich auf Datenformate automatisch – Änderungen werden transparent abgestimmt."
  },
  {
    level: "11+",
    name: "Trustless Kollaboration",
    yourBenefit: "Zusammenarbeit ohne blindes Vertrauen",
    description: "Agenten verhandeln automatisch – mit kryptographisch garantierter Fairness",
    example: "Automatische Vertragsverhandlungen zwischen Unternehmen – jeder kann die Einhaltung verifizieren."
  }
];
---

<BaseLayout
  title="Ausblick: Level 6-11+ | Sigloch Consulting"
  description="Von vorausschauender Analyse bis firmenübergreifender Zusammenarbeit. Die höheren Stufen der Datenreife – und Ihr konkreter Mehrwert auf jeder Stufe."
>
  <Header />

  <main>
    <article class="article" data-testid="article-ausblick">
      <header class="article-header">
        <div class="container">
          <a href="/mein-ansatz" class="back-link">← Mein Ansatz</a>
          <h1>Ausblick</h1>
          <p class="article-subtitle">
            Level 6-11+: Von intelligenten Systemen zu firmenübergreifender Zusammenarbeit
          </p>
        </div>
      </header>

      <div class="container article-content">
        <section>
          <h2>Jenseits des Fundaments</h2>
          <p>
            Mit Level 5 (Messbare Qualität) ist das Fundament gelegt: 70-80% Business Value
            durch Struktur und Regeln. Ab hier wird KI operativ relevant –
            aber auf Basis der geschaffenen Struktur.
          </p>
          <p>
            Die folgenden Stufen sind keine Zukunftsmusik. Für jede existieren
            bereits konkrete Lösungen (Stand 2025).
          </p>
        </section>

        <section>
          <h2>Level 6-8: Intelligente Systeme</h2>
          <p>
            Ab hier wird KI operativ relevant – aber auf Basis des strukturellen Fundaments.
          </p>
          <div class="advanced-levels">
            {advancedLevels.map((level) => (
              <div class="level-card" data-testid={`level-${level.level}`}>
                <div class="level-header">
                  <span class="level-number">{level.level}</span>
                  <h3>{level.name}</h3>
                </div>
                <p class="your-benefit"><strong>Ihr Mehrwert:</strong> {level.yourBenefit}</p>
                <p class="level-description">{level.description}</p>
                <p class="level-example"><strong>Beispiel:</strong> {level.example}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>Level 9-11+: Firmenübergreifende Zusammenarbeit</h2>
          <p>
            Ab Level 9 wird es spannend: Das System optimiert nicht mehr nur intern,
            sondern kann von externem Wissen profitieren – <strong>ohne Ihre Daten preiszugeben</strong>.
          </p>

          <div class="context-box">
            <h3>Warum das wichtig ist</h3>
            <p>
              Jedes Unternehmen löst dieselben Probleme isoliert. Ihre Lieferanten,
              Partner und sogar Wettbewerber haben ähnliche Herausforderungen –
              aber niemand teilt Lösungen, weil das Geschäftsgeheimnisse gefährden würde.
            </p>
            <p>
              <strong>Die Lösung:</strong> Moderne Architekturen ermöglichen es,
              Erkenntnisse zu teilen ohne Daten zu teilen.
            </p>
          </div>

          <div class="advanced-levels">
            {collaborationLevels.map((level) => (
              <div class="level-card collaboration" data-testid={`level-${level.level}`}>
                <div class="level-header">
                  <span class="level-number">{level.level}</span>
                  <h3>{level.name}</h3>
                </div>
                <p class="your-benefit"><strong>Ihr Mehrwert:</strong> {level.yourBenefit}</p>
                <p class="level-description">{level.description}</p>
                <p class="level-example"><strong>Beispiel:</strong> {level.example}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>Der wichtige Punkt</h2>
          <p>
            Auch auf den höchsten Stufen bleibt das strukturelle Fundament entscheidend.
            KI ist der Beschleuniger – nicht der Ersatz für solide Grundlagen.
          </p>
          <p>
            <strong>Empfehlung:</strong> Erst das Fundament (Level 5), dann den Ausblick.
            Die meisten Unternehmen unterschätzen, wie viel Wert bereits in den
            ersten Stufen steckt.
          </p>
        </section>

        <section>
          <h2>Wo wollen Sie hin?</h2>
          <p>
            Level 5 als Basis für die gute KI-Anwendung liefert bereits einen hohen Nutzen.
            Level 6-8 ist an vielen Stellen schon Stand der Technik 
          </p>
          <p>
            Und auch wenn sich Level 9+ wie Science-Fiction liest: Die Eintrittswahrscheinlichkeit ist hoch.
            Der potentielle Impact auf Ihr Business ebenfalls.
            Also besser heute schon die Chancen und Risiken evaluieren.
          </p>
        </section>

        <section class="cta-box">
          <h2>Fundament zuerst - Zukunft im Blick</h2>
          <p>
            Lassen Sie uns klären, wo Sie auf der Leiter stehen –
            und welcher nächste Schritt den größten Hebel hat.
          </p>
          <a href="/kontakt" class="button button-primary">Gespräch vereinbaren</a>
        </section>

        <ArticleNavigation currentPath="/mein-ansatz/ausblick" />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-header {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-16) 0;
  }

  .back-link {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-header h1 {
    margin-bottom: var(--space-4);
  }

  .article-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  .article-content {
    max-width: 750px;
    padding: var(--space-12) var(--container-padding);
  }

  .article-content section {
    margin-bottom: var(--space-12);
  }

  .article-content h2 {
    margin-bottom: var(--space-6);
    margin-top: var(--space-8);
  }

  .article-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    margin-top: var(--space-6);
  }

  .article-content p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  /* Advanced Levels */
  .advanced-levels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .level-card {
    background: var(--color-background-alt);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .level-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .level-number {
    width: 36px;
    height: 36px;
    background: var(--color-primary);
    color: var(--color-background);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }

  .level-title {
    flex-grow: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .level-title h3 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .stat.value {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-success-bg);
    color: var(--color-success-text);
  }

  .level-description {
    font-size: var(--text-base) !important;
    margin-bottom: var(--space-2) !important;
  }

  .level-example {
    font-size: var(--text-sm) !important;
    background: var(--color-background);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    margin-bottom: 0 !important;
    border-left: 3px solid var(--color-primary);
  }

  .your-benefit {
    font-size: var(--text-base) !important;
    color: var(--color-success-text) !important;
    font-weight: var(--font-medium);
    margin-bottom: var(--space-2) !important;
  }

  .level-card.collaboration {
    border-left-color: var(--color-accent, var(--color-primary));
    background: linear-gradient(
      135deg,
      var(--color-background-alt) 0%,
      var(--color-primary-50) 100%
    );
  }

  /* Context Box */
  .context-box {
    background: var(--color-background-alt);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
    border-left: 4px solid var(--color-primary);
  }

  .context-box h3 {
    font-size: var(--text-lg);
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .context-box p {
    font-size: var(--text-base) !important;
    margin-bottom: var(--space-2) !important;
  }

  .context-box p:last-child {
    margin-bottom: 0 !important;
  }

  /* Benefit Boxes */
  .benefit-box {
    background: var(--color-background-alt);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
    border-top: 4px solid var(--color-primary);
  }

  .benefit-box h3 {
    color: var(--color-primary);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .benefit-box p {
    font-size: var(--text-base) !important;
  }

  .benefit-example {
    font-size: var(--text-sm) !important;
    background: var(--color-background);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    margin-bottom: 0 !important;
    border-left: 3px solid var(--color-primary);
  }

  /* CTA Box */
  .cta-box {
    background: var(--color-primary-50);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    text-align: center;
    margin-top: var(--space-16);
  }

  .cta-box h2 {
    margin-top: 0;
  }

  .cta-box p {
    margin-bottom: var(--space-6);
  }

  @media (max-width: 768px) {
    .level-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .level-title {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .level-number {
      width: 32px;
      height: 32px;
    }
  }
</style>
