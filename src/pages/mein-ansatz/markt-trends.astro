---
/**
 * Hintergrund: Markt & Trends
 * @author andreas@siglochconsulting.de
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleNavigation from '../../components/ArticleNavigation.astro';

const marketPlayers = [
  {
    name: "Die großen Tech-Konzerne",
    level: "8-10",
    focus: "Globale Plattformen",
    valuation: "",
    strengths: [
      "Massive Datenmengen und globale Infrastruktur",
      "Jahrzehnte Erfahrung mit Datenstrukturen",
      "Kontinuierliche Optimierung durch Nutzerdaten",
      "Milliarden-Investitionen in KI-Forschung"
    ],
    positioning: "Nicht direkt übertragbar – andere Größenordnung",
    mittelstandRelevanz: "Zeigen aber: Erfolg basiert auf strukturierten Daten, nicht nur auf KI-Modellen."
  },
  {
    name: "Enterprise-Anbieter (z.B. Palantir)",
    level: "3-7",
    focus: "Unternehmen & regulierte Branchen",
    valuation: "~$50 Mrd. Bewertung",
    strengths: [
      "Verknüpfte Daten als Kern – KI nur als Ergänzung",
      "Automatische Regeln und messbare Qualität",
      "Mitarbeiter fragen Daten in natürlicher Sprache ab",
      "Spezialisiert auf regulierte Branchen (Medizin, Automotive, Behörden)"
    ],
    positioning: "Genau der Ansatz, den ich empfehle",
    mittelstandRelevanz: "Die Prinzipien sind übertragbar – ohne Millionen-Lizenzkosten."
  }
];

const maturityStudies = [
  {
    source: "RAND Corporation (2024)",
    finding: "80% der KI-Projekte scheitern – doppelt so viele wie normale IT-Projekte",
    url: "https://www.rand.org/pubs/research_reports/RRA2680-1.html",
    detail: "Basiert auf 65 Interviews mit Praktikern. Hauptursache: fehlende Datenqualität."
  },
  {
    source: "McKinsey State of AI 2025",
    finding: "Top-Performer investieren zuerst in Dateninfrastruktur, dann in KI",
    url: "https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai",
    detail: "Global Survey mit 1.400+ Führungskräften."
  },
  {
    source: "MIT Sloan (2025)",
    finding: "95% der GenAI-Pilotprojekte schaffen es nicht in den produktiven Einsatz",
    url: "https://sloanreview.mit.edu/article/why-ai-projects-fail-to-scale/",
    detail: "Strukturelle Voraussetzungen fehlen für Skalierung."
  }
];

---

<BaseLayout
  title="Markt & Trends - Was erfolgreiche Unternehmen anders machen | Sigloch Consulting"
  description="Die meisten KI-Projekte scheitern. Erfolgreiche Unternehmen setzen auf Struktur vor KI. Was RAND, McKinsey und MIT dazu sagen."
>
  <Header />

  <main>
    <article class="article" data-testid="article-markt-trends">
      <header class="article-header">
        <div class="container">
          <a href="/mein-ansatz" class="back-link">← Mein Ansatz</a>
          <h1>Markt & Trends</h1>
          <p class="article-subtitle">
            Was erfolgreiche Unternehmen anders machen
          </p>
        </div>
      </header>

      <div class="container article-content">
        <section>
          <h2>Die Realität hinter dem KI-Hype</h2>
          <p>
            Die meisten KI-Projekte scheitern. Das zeigen unabhängige Studien von
            RAND, McKinsey und MIT übereinstimmend. Der Grund ist fast immer derselbe:
            <strong>fehlende Datenqualität und unklare Strukturen</strong> – nicht
            die Technologie selbst.
          </p>
        </section>

        <section>
          <h2>Was die Studien zeigen</h2>
          <div class="studies-grid">
            {maturityStudies.map((study) => (
              <div class="study-card">
                <h3>
                  <a href={study.url} target="_blank" rel="noopener noreferrer">
                    {study.source}
                  </a>
                </h3>
                <p class="study-finding">„{study.finding}"</p>
                <p class="study-detail">{study.detail}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>Enterprise-Player auf der Leiter</h2>
          <div class="players-grid">
            {marketPlayers.map((player) => (
              <div class="player-card" data-testid={`player-${player.name.toLowerCase()}`}>
                <div class="player-header">
                  <h3>{player.name}</h3>
                  <span class="player-level">Stufe {player.level}</span>
                </div>
                <p class="player-valuation">{player.valuation}</p>
                <p class="player-focus">{player.focus}</p>
                <ul class="player-strengths">
                  {player.strengths.map((strength) => (
                    <li>{strength}</li>
                  ))}
                </ul>
                <p class="player-positioning">
                  <strong>Positionierung:</strong> {player.positioning}
                </p>
                <p class="player-mittelstand">
                  <strong>Für Mittelstand:</strong> {player.mittelstandRelevanz}
                </p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>Was das für Sie bedeutet</h2>

          <div class="insight-box">
            <h3>Google-Modell (Stufe 9-10)</h3>
            <p>
              Für Unternehmen mit massiven Datenmengen und Consumer-Fokus.
              Erfordert enorme Infrastruktur-Investitionen und globale Skalierung.
            </p>
            <p class="insight-verdict">
              <strong>Für Mittelstand:</strong> Nicht direkt übertragbar, aber inspirierend
              für Federated-Learning-Ansätze in Branchen-Konsortien.
            </p>
          </div>

          <div class="insight-box highlight">
            <h3>Palantir-Modell (Stufe 3-7)</h3>
            <p>
              Für domänenspezifische, regulierte Umgebungen.
              Ontologie + Rules + LLM-Interface. Entspricht dem technischen Ansatz, den ich empfehle.
            </p>
            <p class="insight-verdict">
              <strong>Für Mittelstand:</strong> Direkt übertragbar mit Open-Source-Stack
              (Neo4j, SHACL, Ollama) statt Palantir-Lizenz.
            </p>
          </div>
        </section>

        <section>
          <h2>Der Mittelstands-Vorteil</h2>
          <p>
            Großkonzerne setzen auf teure Plattformen (ab $1M/Jahr).
            Die gute Nachricht: Dieselben Prinzipien funktionieren auch mit
            deutlich geringeren Budgets.
          </p>
          <div class="cost-comparison">
            <div class="cost-item enterprise">
              <h4>Enterprise-Plattformen</h4>
              <p class="cost-value">$1M+ pro Jahr</p>
              <p>Fertige Lösungen für Großkonzerne</p>
            </div>
            <div class="cost-item mittelstand">
              <h4>Mittelstands-Ansatz</h4>
              <p class="cost-value">€20-50k einmalig</p>
              <p>Gleiche Prinzipien, andere Umsetzung</p>
            </div>
          </div>
          <p>
            Details zur technischen Umsetzung finden Sie im
            <a href="/mein-ansatz/technik">Artikel zum technischen Stack</a>.
          </p>
        </section>

        <section>
          <h2>Trend-Prognose 2025-2027</h2>
          <div class="trends-list">
            <div class="trend">
              <span class="trend-marker">1</span>
              <div class="trend-content">
                <h3>Ontologie wird Standard</h3>
                <p>
                  Enterprise-Software integriert Graph-basierte Datenmodelle.
                  SAP, Salesforce, Microsoft investieren massiv in Knowledge Graphs.
                </p>
              </div>
            </div>
            <div class="trend">
              <span class="trend-marker">2</span>
              <div class="trend-content">
                <h3>LLM-Kosten sinken, Struktur-ROI steigt</h3>
                <p>
                  Sinkende LLM-Preise machen KI zugänglicher – aber erhöhen den
                  relativen Wert strukturierter Daten als Differenzierungsmerkmal.
                </p>
              </div>
            </div>
            <div class="trend">
              <span class="trend-marker">3</span>
              <div class="trend-content">
                <h3>Regulation erzwingt Traceability</h3>
                <p>
                  EU AI Act, MDR, ISO 26262: Nachvollziehbarkeit wird Pflicht.
                  Black-Box-KI ohne strukturierte Basis wird regulatorisch riskant.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="cta-box">
          <h2>Ihre Position?</h2>
          <p>
            Lassen Sie uns klären, wo Sie stehen –
            und welche Schritte den größten Hebel haben.
          </p>
          <a href="/kontakt" class="button button-primary">Gespräch vereinbaren</a>
        </section>

        <ArticleNavigation currentPath="/mein-ansatz/markt-trends" />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-header {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-16) 0;
  }

  .back-link {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-header h1 {
    margin-bottom: var(--space-4);
  }

  .article-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  .article-content {
    max-width: 850px;
    padding: var(--space-12) var(--container-padding);
  }

  .article-content section {
    margin-bottom: var(--space-12);
  }

  .article-content h2 {
    margin-bottom: var(--space-6);
    margin-top: var(--space-8);
  }

  .article-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    margin-top: var(--space-6);
  }

  .article-content p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .article-content ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .article-content li {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  /* Studies Grid */
  .studies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .study-card {
    background: var(--color-background-alt);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--color-primary);
  }

  .study-card h3 {
    font-size: var(--text-base);
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .study-finding {
    font-size: var(--text-base) !important;
    font-style: italic;
    margin-bottom: var(--space-3) !important;
  }

  .study-link {
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  /* Players Grid */
  .players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .player-card {
    background: var(--color-background-alt);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .player-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .player-header h3 {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .player-level {
    background: var(--color-primary);
    color: var(--color-background);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .player-focus {
    font-size: var(--text-base) !important;
    color: var(--color-primary) !important;
    font-weight: var(--font-medium);
    margin-bottom: var(--space-4) !important;
  }

  .player-strengths {
    margin-bottom: var(--space-4);
  }

  .player-positioning {
    font-size: var(--text-sm) !important;
    background: var(--color-background);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    margin-bottom: 0 !important;
  }

  /* Insight Boxes */
  .insight-box {
    background: var(--color-background-alt);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .insight-box.highlight {
    background: var(--color-primary-50);
    border: 2px solid var(--color-primary);
  }

  .insight-box h3 {
    margin-top: 0;
    color: var(--color-primary);
  }

  .insight-verdict {
    font-size: var(--text-base) !important;
    background: var(--color-background);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    margin-bottom: 0 !important;
  }

  /* Cost Comparison */
  .cost-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .cost-item {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .cost-item.enterprise {
    background: var(--color-background-alt);
    border: 2px solid var(--color-border);
  }

  .cost-item.mittelstand {
    background: var(--color-primary-50);
    border: 2px solid var(--color-primary);
  }

  .cost-item h4 {
    font-size: var(--text-base);
    margin: 0 0 var(--space-2) 0;
  }

  .cost-value {
    font-size: var(--text-2xl) !important;
    font-weight: var(--font-bold);
    color: var(--color-primary) !important;
    margin: 0 0 var(--space-2) 0 !important;
  }

  .cost-item p:last-child {
    font-size: var(--text-sm) !important;
    color: var(--color-text-secondary) !important;
    margin: 0 !important;
  }

  /* Trends List */
  .trends-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .trend {
    display: flex;
    gap: var(--space-4);
    background: var(--color-background-alt);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
  }

  .trend-marker {
    width: 36px;
    height: 36px;
    background: var(--color-primary);
    color: var(--color-background);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-bold);
    flex-shrink: 0;
  }

  .trend-content h3 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2) 0;
  }

  .trend-content p {
    font-size: var(--text-base) !important;
    margin: 0 !important;
  }

  /* CTA Box */
  .cta-box {
    background: var(--color-primary-50);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    text-align: center;
    margin-top: var(--space-16);
  }

  .cta-box h2 {
    margin-top: 0;
  }

  .cta-box p {
    margin-bottom: var(--space-6);
  }

  @media (max-width: 768px) {
    .players-grid {
      grid-template-columns: 1fr;
    }

    .player-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .trend {
      flex-direction: column;
      gap: var(--space-3);
    }
  }

  .study-card h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .study-card h3 a:hover {
    text-decoration: underline;
  }

  .study-detail {
    font-size: var(--text-sm) !important;
    color: var(--color-text-light) !important;
    margin-top: var(--space-2) !important;
    margin-bottom: 0 !important;
  }

  .player-valuation {
    font-size: var(--text-sm) !important;
    color: var(--color-text-light) !important;
    margin-bottom: var(--space-2) !important;
  }

  .player-mittelstand {
    font-size: var(--text-sm) !important;
    background: var(--color-primary-50);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    margin-top: var(--space-3) !important;
    margin-bottom: 0 !important;
  }

</style>
