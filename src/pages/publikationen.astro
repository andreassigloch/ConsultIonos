---
/**
 * Publikationen - Blog, LinkedIn, Konferenzen
 * @author andreas@siglochconsulting.de
 *
 * Zusammengeführt aus /wissenswertes und /beitraege
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Blog-Artikel aus Content Collection
const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedBlogPosts = blogPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Separate by LinkedIn status
const linkedinPublished = sortedBlogPosts.filter(p => p.data.linkedinStatus === 'published');
const blogOnly = sortedBlogPosts.filter(p => p.data.linkedinStatus !== 'published');

interface ExternalPublication {
  title: string;
  type: "linkedin" | "conference";
  url?: string;
  downloadUrl?: string;
  pubDate: string;
  tags: string[];
  excerpt: string;
}

const externalPublications: ExternalPublication[] = [
  {
    title: "Sysli - Systems Engineering light - REConf 2025",
    type: "conference",
    downloadUrl: "/downloads/ReConf2025_Sysli_pitch_website.pdf",
    pubDate: "2025-03-12",
    tags: ["Konferenz", "Systems Engineering", "GenAI", "Agenten"],
    excerpt: "Leichtgewichtiges Systems Engineering mit KI-Unterstützung: Methodenwissen abrufen statt erlernen, automatische Dokumentation, schrittweise Einführung - ohne Overhead, mit vollem Nutzen."
  }
];

const typeLabels: Record<string, string> = {
  linkedin: "LinkedIn",
  conference: "Konferenz",
  blog: "Blog"
};

const typeIcons: Record<string, string> = {
  linkedin: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  conference: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>`,
  blog: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>`
};

function formatDate(date: Date | string): string {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout
  title="Publikationen - Blog & Artikel | Sigloch Consulting"
  description="Blog-Artikel, LinkedIn-Beiträge und Konferenzvorträge zu Systems Engineering, GenAI und Datenstrukturierung."
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" data-testid="publications-hero">
      <div class="container">
        <h1>Publikationen</h1>
        <p class="hero-subtitle">
          Blog-Artikel, LinkedIn-Beiträge und Konferenzvorträge
        </p>
      </div>
    </section>

    <!-- Filter Navigation -->
    <nav class="filter-nav" data-testid="filter-nav">
      <div class="container">
        <a href="#blog" class="filter-link">Blog</a>
        <a href="#linkedin" class="filter-link">LinkedIn</a>
        <a href="#konferenzen" class="filter-link">Konferenzen</a>
      </div>
    </nav>

    <!-- Blog Section (not yet on LinkedIn) -->
    <section class="publications-section" id="blog" data-testid="blog-section">
      <div class="container">
        <h2 class="section-title">
          <span class="section-icon" set:html={typeIcons.blog}></span>
          Blog
        </h2>
        <p class="section-subtitle">Artikel, die noch nicht auf LinkedIn veröffentlicht wurden</p>

        <div class="publications-list">
          {blogOnly.map((post) => (
            <article class="publication-card" data-testid={`blog-${post.slug}`}>
              <div class="publication-meta">
                <span class="publication-type type-blog">Blog</span>
                <span class="publication-date">{formatDate(post.data.pubDate)}</span>
              </div>

              <h3 class="publication-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>

              <p class="publication-excerpt">{post.data.description}</p>

              <div class="publication-tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <a href={`/blog/${post.slug}`} class="publication-link">
                Weiterlesen →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- LinkedIn Section (articles published on LinkedIn) -->
    <section class="publications-section alternate" id="linkedin" data-testid="linkedin-section">
      <div class="container">
        <h2 class="section-title">
          <span class="section-icon" set:html={typeIcons.linkedin}></span>
          LinkedIn
        </h2>
        <p class="section-subtitle">Auf LinkedIn veröffentlichte Artikel ({linkedinPublished.length})</p>

        <div class="publications-list">
          {linkedinPublished.map((post) => (
            <article class="publication-card" data-testid={`linkedin-${post.slug}`}>
              <div class="publication-meta">
                <span class="publication-type type-linkedin">LinkedIn</span>
                <span class="publication-date">{formatDate(post.data.linkedinPostDate || post.data.pubDate)}</span>
              </div>

              <h3 class="publication-title">
                {post.data.linkedinUrl ? (
                  <a href={post.data.linkedinUrl} target="_blank" rel="noopener noreferrer">{post.data.title}</a>
                ) : (
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                )}
              </h3>

              <p class="publication-excerpt">{post.data.description}</p>

              <div class="publication-tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <div class="publication-actions">
                <a href={`/blog/${post.slug}`} class="publication-link">
                  Artikel lesen →
                </a>
                {post.data.linkedinUrl && (
                  <a href={post.data.linkedinUrl} target="_blank" rel="noopener noreferrer" class="publication-link linkedin-link">
                    Auf LinkedIn →
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>

        <div class="linkedin-cta">
          <a href="https://www.linkedin.com/in/andreas-sigloch-consulting" target="_blank" rel="noopener noreferrer" class="button button-secondary">
            LinkedIn Profil →
          </a>
        </div>
      </div>
    </section>

    <!-- Conference Section -->
    <section class="publications-section" id="konferenzen" data-testid="conference-section">
      <div class="container">
        <h2 class="section-title">
          <span class="section-icon" set:html={typeIcons.conference}></span>
          Konferenzen
        </h2>

        <div class="publications-list">
          {externalPublications.filter(p => p.type === 'conference').map((pub, index) => (
            <article class="publication-card" data-testid={`conference-${index}`}>
              <div class="publication-meta">
                <span class="publication-type type-conference">Konferenz</span>
                <span class="publication-date">{formatDate(pub.pubDate)}</span>
              </div>

              <h3 class="publication-title">{pub.title}</h3>

              <p class="publication-excerpt">{pub.excerpt}</p>

              <div class="publication-tags">
                {pub.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              {pub.downloadUrl && (
                <a href={pub.downloadUrl} target="_blank" rel="noopener noreferrer" class="publication-link" download>
                  PDF herunterladen →
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" data-testid="publications-cta">
      <div class="container cta-content">
        <h2>Eigenes Thema?</h2>
        <p>
          Lassen Sie uns über Ihre spezifischen Herausforderungen sprechen.
        </p>
        <a href="/kontakt" class="button button-primary button-large" data-testid="cta-contact">
          Gespräch vereinbaren
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    padding: var(--space-20) 0 var(--space-12);
    text-align: center;
  }

  .page-hero h1 {
    margin-bottom: var(--space-4);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  /* Filter Navigation */
  .filter-nav {
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .filter-nav .container {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
  }

  .filter-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: var(--font-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .filter-link:hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  /* Publications Section */
  .publications-section {
    padding: var(--space-16) 0;
  }

  .publications-section.alternate {
    background: var(--color-background-alt);
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-10);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .section-icon {
    color: var(--color-primary);
    display: flex;
    align-items: center;
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: var(--space-8);
    font-size: var(--text-base);
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 800px;
  }

  /* Publication Card */
  .publication-card {
    background: var(--color-background);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .publications-section.alternate .publication-card {
    background: var(--color-background);
  }

  .publication-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .publication-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }

  .publication-type {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: var(--font-semibold);
  }

  .publication-type.type-linkedin {
    background: var(--color-linkedin-bg);
    color: var(--color-linkedin);
  }

  .publication-type.type-blog {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  .publication-type.type-conference {
    background: var(--color-conference-bg);
    color: var(--color-conference);
  }

  .publication-date {
    color: var(--color-text-light);
  }

  .publication-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
    line-height: var(--leading-snug);
  }

  .publication-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .publication-title a:hover {
    color: var(--color-primary);
  }

  .publication-excerpt {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .publication-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .publication-link {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .publication-link:hover {
    color: var(--color-primary-600);
  }

  .publication-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .publication-link.linkedin-link {
    color: var(--color-linkedin);
  }

  .publication-link.linkedin-link:hover {
    color: var(--color-linkedin-dark);
  }

  .linkedin-cta {
    margin-top: var(--space-8);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-16) 0;
    background: linear-gradient(
      135deg,
      var(--color-primary-700) 0%,
      var(--color-primary-600) 50%,
      var(--color-primary-700) 100%
    );
    color: var(--color-background);
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-section h2 {
    color: var(--color-background);
    margin-bottom: var(--space-4);
  }

  .cta-section p {
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
    opacity: 0.9;
  }

  .cta-section .button-primary {
    background: var(--color-background);
    color: var(--color-primary);
    border-color: var(--color-background);
  }

  .cta-section .button-primary:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .filter-nav .container {
      gap: var(--space-3);
    }

    .filter-link {
      font-size: var(--text-sm);
      padding: var(--space-2) var(--space-3);
    }

    .publication-title {
      font-size: var(--text-xl);
    }

    .publication-meta {
      flex-wrap: wrap;
    }
  }
</style>
